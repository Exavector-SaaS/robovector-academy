classDiagram

%% =========================================================
%% CURRICULUM LAYER
%% =========================================================

class Course {
    +UUID id
    +String title
    +String status
}

class Module {
    +UUID id
    +UUID course_id
    +Int order
}

class Lesson {
    +UUID id
    +UUID module_id
}

class Material {
    +UUID id
    +UUID lesson_id
    +String type
}

Course "1" --> "0..*" Module
Module "1" --> "0..*" Lesson
Lesson "1" --> "0..*" Material

%% =========================================================
%% ENROLLMENT LAYER
%% =========================================================

class Enrollment {
    +UUID id
    +UUID student_id
    +UUID course_id
    +EnrollmentStatus status
    +DateTime enrolled_at
}

class Progress {
    +UUID id
    +UUID enrollment_id
    +UUID lesson_id
    +Float completion_ratio
}

Enrollment "1" --> "0..*" Progress
Course "1" --> "0..*" Enrollment

%% =========================================================
%% ASSESSMENT LAYER
%% =========================================================

class Assessment {
    +UUID id
    +String title
    +String type
    +UUID course_id
}

class Submission {
    +UUID id
    +UUID enrollment_id
    +UUID assessment_id
    +Float score
}

class Answer {
    +UUID id
    +UUID submission_id
    +String value
}

Assessment "1" --> "0..*" Submission
Submission "1" --> "0..*" Answer
Enrollment "1" --> "0..*" Submission
Assessment --> Course

%% =========================================================
%% COMPETENCY FRAMEWORK
%% =========================================================

class Skill {
    +UUID id
    +String name
    +String description
}

class Competency {
    +UUID id
    +String name
    +String description
    +CompetencyLevel level
}

class SkillCompetency {
    +UUID skill_id
    +UUID competency_id
}

class LessonCompetency {
    +UUID lesson_id
    +UUID competency_id
    +Float weight
}

class Evidence {
    +UUID id
    +UUID student_id
    +UUID competency_id
    +Float score
    +String source_type
    +UUID source_id
}

class StudentCompetency {
    +UUID student_id
    +UUID competency_id
    +Float mastery_level
    +DateTime last_updated
}

Skill "1" --> "0..*" SkillCompetency
Competency "1" --> "0..*" SkillCompetency

Lesson "1" --> "0..*" LessonCompetency
Competency "1" --> "0..*" LessonCompetency

Competency "1" --> "0..*" Evidence
Competency "1" --> "0..*" StudentCompetency

SkillCompetency --> Skill
SkillCompetency --> Competency

LessonCompetency --> Lesson
LessonCompetency --> Competency

Evidence --> StudentCompetency : updates

Submission --> Evidence : generates
Progress --> Evidence : generates

%% =========================================================
%% BILLING LAYER
%% =========================================================

class Invoice {
    +UUID id
    +UUID student_id
    +Float total_amount
    +String status
}

class Payment {
    +UUID id
    +UUID invoice_id
    +Float amount
    +String status
}

class BillingContext {
    +UUID id
    +String type
    +UUID context_id
}

Invoice "1" --> "0..*" Payment
Enrollment --> Invoice
Enrollment --> BillingContext